<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>BJK.Modules.Media</PackageId>
    <Description>Media module for Bad Jockeys: photo and video uploads to Cloudflare R2, processing jobs (SQL Server queue), and media records. Hosted by the bjk-core API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="AWSSDK.S3" />
    <!-- Face and number plate detection on the CPU (MIT licence). Only the media worker uses it. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <!-- Only for `dotnet ef migrations add`; not passed on to hosts that use the package. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BJK.Modules.Shared\BJK.Modules.Shared.csproj" />
    <ProjectReference Include="..\BJK.Modules.Queues\BJK.Modules.Queues.csproj" />
    <ProjectReference Include="..\BJK.Modules.Safety\BJK.Modules.Safety.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CLIP text embeddings for the nudity and graphic content check (see ClipContentClassifier). -->
    <EmbeddedResource Include="Infrastructure\Processing\Sensitive\clip-prompts.json" LogicalName="BJK.Modules.Media.clip-prompts.json" />
    <!-- The watermark and end card of the vertical copies made for sharing (see ShareVideoAssets). -->
    <EmbeddedResource Include="Infrastructure\Processing\Share\watermark.png" LogicalName="BJK.Modules.Media.share-watermark.png" />
    <EmbeddedResource Include="Infrastructure\Processing\Share\endcard.png" LogicalName="BJK.Modules.Media.share-endcard.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BJK.Modules.Media.Tests" />
    <!-- NSubstitute needs this to mock internal interfaces. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>

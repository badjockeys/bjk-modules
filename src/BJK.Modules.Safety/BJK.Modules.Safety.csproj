<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>BJK.Modules.Safety</PackageId>
    <Description>Online safety checks for Bad Jockeys modules: text checks (number plates, phone numbers, addresses, handles), comment and post screening (keyword list, plus an optional classifier), blocked web addresses, Cloudflare Turnstile CAPTCHA, and the age-verification gate for commands.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BJK.Modules.Shared\BJK.Modules.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BJK.Modules.Safety.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>

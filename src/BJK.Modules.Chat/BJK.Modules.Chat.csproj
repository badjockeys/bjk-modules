<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>BJK.Modules.Chat</PackageId>
    <Description>Chat module for Bad Jockeys: Ask AI, the Premium AI chat. An open model writes read-only SQL over the reporting.Incidents and reporting.Subcategories views, checked by a T-SQL parser and run through the bjk_chat login with the member's plan date limits, small counts hidden and daily question limits. Hosted by the bjk-core API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
    <!-- Only for `dotnet ef migrations add`; not passed on to hosts that use the package. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BJK.Modules.Shared\BJK.Modules.Shared.csproj" />
    <ProjectReference Include="..\BJK.Modules.Queues\BJK.Modules.Queues.csproj" />
    <ProjectReference Include="..\BJK.Modules.Safety\BJK.Modules.Safety.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BJK.Modules.Chat.Tests" />
    <!-- NSubstitute needs this to mock internal interfaces. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>BJK.Modules.Shared</PackageId>
    <Description>The common base every Bad Jockeys module and host builds on: module registration, the MediatR pipeline and validation, error handling, the signed-in caller and sign-in scheme, staff roles and plans, safe startup migrations, deployed-settings checks, personal data export, supplier retries, and the small interfaces modules use to talk to each other (notifications, media usage, the moderation audit log, user lifecycle events). Safety checks, queues and OpenTelemetry are in BJK.Modules.Safety, BJK.Modules.Queues and BJK.Modules.Observability.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BJK.Modules.Shared.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>

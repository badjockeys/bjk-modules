<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>BJK.Modules.Shared</PackageId>
    <Description>Shared building blocks for Bad Jockeys modules: module registration, MediatR pipeline, validation, error handling, messaging (RabbitMQ and outbox), user lifecycle events, personal data export, and online safety (text checks, content screening, CAPTCHA, age verification, moderation audit contract).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

</Project>

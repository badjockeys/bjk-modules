<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>BJK.Modules.Profiles</PackageId>
    <Description>Profiles module for Bad Jockeys: public profiles (handle, display name, avatar, bio, location). Hosted by the bjk-core API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Only for `dotnet ef migrations add`; not passed on to hosts that use the package. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BJK.Modules.Shared\BJK.Modules.Shared.csproj" />
    <ProjectReference Include="..\BJK.Modules.Media\BJK.Modules.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BJK.Modules.Profiles.Tests" />
    <!-- NSubstitute needs this to mock internal interfaces. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
